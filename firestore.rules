rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function anonymousUser() {
      return signedIn() && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }
    function userPath(uid) { return /databases/$(database)/documents/users/$(uid); }
    function voterPath(voterId) { return /databases/$(database)/documents/voterRoster/$(voterId); }
    function codePath(codeHash) { return /databases/$(database)/documents/loginCodes/$(codeHash); }
    function ballotPath(electionId, ballotId) {
      return /databases/$(database)/documents/elections/$(electionId)/ballots/$(ballotId);
    }
    function admin() {
      return signedIn() && adminProfileIsActive();
    }
    function adminProfileIsActive() {
      let profile = get(userPath(request.auth.uid)).data;
      return profile.active == true && profile.role == 'admin';
    }
    function activeVoter() {
      return signedIn() && exists(userPath(request.auth.uid))
        && get(userPath(request.auth.uid)).data.active == true
        && get(userPath(request.auth.uid)).data.role in ['admin', 'voter'];
    }
    function validSector(sector) {
      return sector in ['Ngành Chiên', 'Ngành Ấu', 'Ngành Thiếu', 'Ngành Nghĩa', 'Ngành Hiệp', 'Ban Điều hành', 'Khác'];
    }
    function validBallotCreate(electionId, ballotId) {
      let profile = get(userPath(request.auth.uid)).data;
      let election = get(/databases/$(database)/documents/elections/$(electionId)).data;
      let round = request.resource.data.round;
      let candidateIds = request.resource.data.candidateIds;
      let requiredCount = round == 1 ? 11 : 5;
      let allowedIds = round == 1 ? election.round1CandidateIds : election.round2CandidateIds;
      let expectedBallotId = (round == 1 ? '1_' : '2_') + profile.voterId;
      return electionId == 'current'
        && activeVoter()
        && profile.voterId is string
        && profile.voterId.size() > 0
        && round in [1, 2]
        && ballotId == expectedBallotId
        && request.resource.data.keys().hasOnly(['round', 'voterId', 'voterName', 'candidateIds', 'submittedAt'])
        && request.resource.data.keys().hasAll(['round', 'voterId', 'voterName', 'candidateIds', 'submittedAt'])
        && request.resource.data.voterId == profile.voterId
        && request.resource.data.voterName == profile.name
        && candidateIds is list
        && candidateIds.size() == requiredCount
        && candidateIds.toSet().size() == requiredCount
        && candidateIds.hasOnly(allowedIds)
        && request.resource.data.submittedAt == request.time
        && election.status == 'open'
        && election.activeRound == round
        && election.endsAt > request.time
        && (round == 1
          ? getAfter(/databases/$(database)/documents/elections/$(electionId)).data.round1VotedCount == election.round1VotedCount + 1
          : getAfter(/databases/$(database)/documents/elections/$(electionId)).data.round2VotedCount == election.round2VotedCount + 1);
    }
    function validVoterCounterUpdate(electionId) {
      let profile = get(userPath(request.auth.uid)).data;
      let affected = request.resource.data.diff(resource.data).affectedKeys();
      return electionId == 'current'
        && activeVoter()
        && resource.data.status == 'open'
        && resource.data.endsAt > request.time
        && ((resource.data.activeRound == 1
          && affected.hasOnly(['round1VotedCount'])
          && request.resource.data.round1VotedCount == resource.data.round1VotedCount + 1
          && getAfter(ballotPath(electionId, '1_' + profile.voterId)).data.round == 1
          && getAfter(ballotPath(electionId, '1_' + profile.voterId)).data.voterId == profile.voterId)
        || (resource.data.activeRound == 2
          && affected.hasOnly(['round2VotedCount'])
          && request.resource.data.round2VotedCount == resource.data.round2VotedCount + 1
          && getAfter(ballotPath(electionId, '2_' + profile.voterId)).data.round == 2
          && getAfter(ballotPath(electionId, '2_' + profile.voterId)).data.voterId == profile.voterId));
    }

    match /users/{uid} {
      allow read: if admin() || (signedIn() && request.auth.uid == uid);
      allow create: if anonymousUser()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'email', 'sector', 'birthDate', 'voterId', 'loginCodeHash', 'active', 'role', 'createdAt'])
        && request.resource.data.keys().hasAll(['name', 'email', 'sector', 'birthDate', 'voterId', 'loginCodeHash', 'active', 'role', 'createdAt'])
        && request.resource.data.active == true
        && request.resource.data.role == 'voter'
        && request.resource.data.createdAt == request.time
        && exists(voterPath(request.resource.data.voterId))
        && get(voterPath(request.resource.data.voterId)).data.active == true
        && get(voterPath(request.resource.data.voterId)).data.name == request.resource.data.name
        && get(voterPath(request.resource.data.voterId)).data.sector == request.resource.data.sector
        && getAfter(codePath(request.resource.data.loginCodeHash)).data.email == request.resource.data.email
        && getAfter(codePath(request.resource.data.loginCodeHash)).data.birthDate == request.resource.data.birthDate
        && request.resource.data.loginCodeHash is string
        && getAfter(codePath(request.resource.data.loginCodeHash)).data.active == true
        && getAfter(codePath(request.resource.data.loginCodeHash)).data.claimedUid == uid
        && getAfter(codePath(request.resource.data.loginCodeHash)).data.voterId == request.resource.data.voterId
        && getAfter(codePath(request.resource.data.loginCodeHash)).data.expiresAt > request.time;
      allow update, delete: if false;
    }

    match /voterRoster/{voterId} {
      allow read: if admin();
      allow create: if admin()
        && request.resource.data.keys().hasOnly(['name', 'email', 'sector', 'birthDate', 'active', 'createdAt'])
        && request.resource.data.keys().hasAll(['name', 'email', 'sector', 'birthDate', 'active', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.email is string
        && request.resource.data.sector is string
        && validSector(request.resource.data.sector)
        && request.resource.data.birthDate is string
        && request.resource.data.active == true
        && request.resource.data.createdAt == request.time;
      allow update, delete: if admin();
    }

    match /loginCodes/{codeHash} {
      allow get: if admin() || (anonymousUser() && (
        resource.data.claimedUid == request.auth.uid
        || (resource.data.active == true
          && resource.data.claimedUid == null
          && resource.data.expiresAt > request.time
          && get(voterPath(resource.data.voterId)).data.loginCodeHash == codeHash)
      ));
      allow list: if admin();
      allow create: if admin()
        && request.resource.data.keys().hasOnly(['voterId', 'name', 'email', 'sector', 'birthDate', 'active', 'claimedUid', 'issuedAt', 'expiresAt'])
        && request.resource.data.keys().hasAll(['voterId', 'name', 'email', 'sector', 'birthDate', 'active', 'claimedUid', 'issuedAt', 'expiresAt'])
        && request.resource.data.active == true
        && request.resource.data.claimedUid == null
        && request.resource.data.issuedAt == request.time
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(4, 'h');
      allow update: if admin() || (anonymousUser()
        && resource.data.active == true
        && resource.data.claimedUid == null
        && resource.data.expiresAt > request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claimedUid'])
        && request.resource.data.claimedUid == request.auth.uid
        && get(voterPath(resource.data.voterId)).data.active == true
        && get(voterPath(resource.data.voterId)).data.loginCodeHash == codeHash
        && getAfter(userPath(request.auth.uid)).data.active == true
        && getAfter(userPath(request.auth.uid)).data.role == 'voter'
        && getAfter(userPath(request.auth.uid)).data.voterId == resource.data.voterId
        && getAfter(userPath(request.auth.uid)).data.loginCodeHash == codeHash
      );
      allow delete: if admin();
    }

    match /loginCodeAttempts/{ipHash} {
      allow read, write: if false;
    }
    match /voterPhones/{phone} {
      allow read, write: if false;
    }

    match /elections/{electionId} {
      allow read: if activeVoter();
      allow create, delete: if admin();
      allow update: if admin() || validVoterCounterUpdate(electionId);
      match /candidates/{candidateId} {
        allow read: if activeVoter();
        allow write: if admin();
      }
      match /tallies/{roundId}/candidates/{candidateId} {
        allow read: if activeVoter();
        allow write: if admin();
      }
      match /ballots/{ballotId} {
        allow get: if admin() || (activeVoter() && (
          ballotId == '1_' + get(userPath(request.auth.uid)).data.voterId
          || ballotId == '2_' + get(userPath(request.auth.uid)).data.voterId
        ));
        allow list: if admin();
        allow create: if validBallotCreate(electionId, ballotId);
        allow update, delete: if false;
      }
      match /runoffs/{runoffId} {
        allow read: if activeVoter();
        allow write: if admin();
      }
    }
  }
}
