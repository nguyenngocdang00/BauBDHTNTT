rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    function isVoter() {
      return signedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true;
    }

    match /users/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create, update, delete: if isAdmin();
    }
    match /elections/{electionId} {
      allow read: if isVoter();
      allow write: if isAdmin();
      match /candidates/{candidateId} {
        allow read: if isVoter();
        allow write: if isAdmin();
      }
      match /ballots/{ballotId} {
        allow create: if isVoter() && ballotId == request.auth.uid
          && request.resource.data.voterUid == request.auth.uid;
        allow read: if isAdmin() || (signedIn() && ballotId == request.auth.uid);
        allow update, delete: if isAdmin();
      }
      match /results/{resultId} {
        allow read: if isAdmin();
        allow write: if isAdmin();
      }
    }
  }
}
